+struct mp_aframe *ao_read_frame(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    struct mp_aframe *result = NULL;
+
+    mp_mutex_lock(&p->lock);
+    if (!p->playing || p->paused)
+        goto done;
+
+    while (!p->pending) {
+        struct mp_frame frame = mp_pin_out_read(p->input->pins[0]);
+        if (!frame.type)
+            break;
+        if (frame.type == MP_FRAME_AUDIO) {
+            p->pending = frame.data;
+            break;
+        }
+        if (frame.type == MP_FRAME_EOF) {
+            p->playing = false;
+            ao->wakeup_cb(ao->wakeup_ctx);
+            break;
+        }
+        mp_frame_unref(&frame);
+    }
+
+    if (p->pending && af_fmt_is_encoded(mp_aframe_get_format(p->pending))) {
+        result = p->pending;
+        p->pending = NULL;
+    }
+
+done:
+    mp_mutex_unlock(&p->lock);
+    return result;
+}
