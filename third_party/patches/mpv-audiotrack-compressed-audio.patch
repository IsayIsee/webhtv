+static int init_raw_filter(struct mp_filter *da)
+{
+    struct spdifContext *ctx = da->priv;
+    struct mp_codec_params *codec = ctx->codec;
+    int format = ctx->codec_id == AV_CODEC_ID_AAC ? AF_FORMAT_AAC : AF_FORMAT_MP3;
+    int rate = codec->samplerate;
+    int channels = codec->channels.num;
+
+    if ((!rate || !channels) && codec->lav_codecpar) {
+        if (!rate)
+            rate = codec->lav_codecpar->sample_rate;
+        if (!channels)
+            channels = codec->lav_codecpar->ch_layout.nb_channels;
+    }
+    if (rate <= 0)
+        rate = ctx->codec_id == AV_CODEC_ID_MP3 ? 44100 : 48000;
+    if (channels <= 0)
+        channels = 2;
+
+    ctx->fmt = mp_aframe_create();
+    talloc_steal(ctx, ctx->fmt);
+    struct mp_chmap chmap;
+    mp_chmap_from_channels(&chmap, channels);
+    if (!mp_aframe_set_chmap(ctx->fmt, &chmap) ||
+        !mp_aframe_set_format(ctx->fmt, format) ||
+        !mp_aframe_set_rate(ctx->fmt, rate))
+    {
+        TA_FREEP(&ctx->fmt);
+        return -1;
+    }
+    ctx->codec_rate = rate;
+    return 0;
+}
+
+static int raw_packet_samples(struct spdifContext *ctx,
+                              const struct demux_packet *pkt)
+{
+    int samples = 0;
+    if (ctx->codec->lav_codecpar)
+        samples = av_get_audio_frame_duration2(ctx->codec->lav_codecpar, pkt->len);
+    if (samples <= 0) {
+        // AAC-LC and MPEG audio packets used by AudioTrack are complete access
+        // units in the demuxer. These defaults cover packets without codecpar.
+        samples = ctx->codec_id == AV_CODEC_ID_AAC ? 1024 : 1152;
+    }
+    return samples;
+}
