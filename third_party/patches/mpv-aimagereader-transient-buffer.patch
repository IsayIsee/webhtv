+static uint64_t get_image_sequence(struct priv *p)
+{
+    mp_mutex_lock(&p->lock);
+    uint64_t sequence = p->image_sequence;
+    mp_mutex_unlock(&p->lock);
+    return sequence;
+}
+
+static bool wait_for_image_signal(struct priv *p, uint64_t *sequence,
+                                  int64_t deadline)
+{
+    mp_mutex_lock(&p->lock);
+    while (p->image_sequence == *sequence && mp_time_ns() < deadline) {
+        if (mp_cond_timedwait_until(&p->cond, &p->lock, deadline))
+            break;
+    }
+    bool changed = p->image_sequence != *sequence;
+    *sequence = p->image_sequence;
+    mp_mutex_unlock(&p->lock);
+    return changed;
+}
+
+static bool wait_for_acquire_fence(struct ra_hwdec_mapper *mapper, int fd,
+                                   int64_t deadline)
+{
+    struct pollfd fence = {
+        .fd = fd,
+        .events = POLLIN,
+    };
+
+    int poll_result;
+    do {
+        int64_t remaining = deadline - mp_time_ns();
+        if (remaining <= 0)
+            return false;
+        poll_result = mp_poll(&fence, 1, remaining);
+    } while (poll_result < 0 && errno == EINTR);
+
+    if (poll_result < 0) {
+        MP_ERR(mapper, "Waiting for AImage acquire fence failed: %d\n",
+               poll_result);
+        return false;
+    }
+    if (poll_result == 0)
+        return false;
+    if (!(fence.revents & POLLIN)) {
+        MP_ERR(mapper, "AImage acquire fence returned invalid events: 0x%x\n",
+               fence.revents);
+        return false;
+    }
+    return true;
+}
+
+static int hold_last_synchronized_frame(struct ra_hwdec_mapper *mapper,
+                                        const char *reason)
+{
+    struct priv *p = mapper->priv;
+    if (!p->has_synchronized_frame || !mapper->tex[0] ||
+        p->transient_hold_count >= TRANSIENT_HOLD_LIMIT)
+        return -1;
+
+    p->transient_hold_count++;
+    p->transient_hold_total++;
+    MP_VERBOSE(mapper,
+               "Holding last synchronized AImage frame reason=%s "
+               "hold=%u/%u total=%u\n",
+               reason, p->transient_hold_count, TRANSIENT_HOLD_LIMIT,
+               p->transient_hold_total);
+    return 0;
+}
+
