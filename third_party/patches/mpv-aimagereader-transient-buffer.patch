+            MP_ERR(mapper, "acquireLatestImage failed: %d\n", ret);
+            return -1;
+        }
+
+        p->no_buffer_count++;
+        if (p->no_buffer_count % TRANSIENT_LOG_INTERVAL == 1) {
+            MP_VERBOSE(mapper, "AImageReader has no buffer yet (count=%u)\n",
+                       p->no_buffer_count);
+        }
+        if (mp_time_ns() >= acquire_deadline ||
+            !wait_for_image_signal(p, &image_sequence, acquire_deadline)) {
+            p->acquire_timeout_count++;
+            if (p->acquire_timeout_count % TRANSIENT_LOG_INTERVAL == 1) {
+                MP_WARN(mapper,
+                        "AImageReader frame acquisition timed out "
+                        "(timeouts=%u, no-buffer=%u)\n",
+                        p->acquire_timeout_count, p->no_buffer_count);
+            }
+            return hold_last_synchronized_frame(mapper, "no-buffer");
+        }
@@ -444,14 +540,24 @@ static int mapper_map(struct ra_hwdec_mapper *mapper)
-        struct pollfd fence = {
-            .fd = acquire_fence,
-            .events = POLLIN,
-        };
